# .env.example  (backlog #200)
#
# Template: copy to `.env` in the project root and fill in what you use.
# `.env` is gitignored (see .gitignore); this file must only ever hold
# placeholders. main.py loads `.env` at startup via python-dotenv, and real
# environment variables win over it. Every line is optional: a missing key
# turns off just the feature that needs it, and Hestia says so when you ask.
#
# Same pattern as config/laptop_config.example.yaml -> config/laptop_config.yaml.
# Rotation: `python scripts/rotate_secrets.py status` lists what is due.

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather. Needed when `telegram.enabled: true`.
TELEGRAM_BOT_TOKEN=

# ── Web UI (webui: in laptop_config.yaml) ───────────────────────────────────
# Login password for the dashboard. Prefer a hash in the YAML
# (python scripts/hash_web_password.py); this is the plain-text alternative.
# Binding the UI to a LAN address requires a password or an API key.
HESTIA_WEB_PASSWORD=
# Key for scripts that call /api/* without a browser session.
HESTIA_WEB_API_KEY=
# Signs the session cookie. If unset a random one is made each start, which
# signs you out on every restart. Any long random string works.
HESTIA_WEB_SECRET=

# ── Sync API (sync: in laptop_config.yaml) ──────────────────────────────────
# Shared secret for /sync/pull and /sync/push. Required if the API is exposed
# beyond localhost.
HESTIA_SYNC_API_KEY=

# ── Encryption at rest (backlog #198) ───────────────────────────────────────
# Key for field-level encryption of journals, finance and health text. Make one
# with:  python scripts/rotate_secrets.py make-data-key
# Lose this key and encrypted fields cannot be read back, so keep a copy
# somewhere safe that is NOT this machine's disk alone. Alternatives: a file
# path in HESTIA_DATA_KEY_FILE (permissions 600), or `security.key_file` in
# the config. Only used when `security.encrypt_at_rest: true`.
HESTIA_DATA_KEY=
# HESTIA_DATA_KEY_FILE=

# ── Language model providers (only if nlu.provider is not local Ollama) ─────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Hermes: Todoist ─────────────────────────────────────────────────────────
# Todoist -> Settings -> Integrations -> Developer. Or todoist.api_token in YAML.
TODOIST_API_TOKEN=

# ── Dionysus: movies and music ──────────────────────────────────────────────
# Free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
# https://developer.spotify.com/dashboard (create an app)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Mnemosyne: paper monitoring ─────────────────────────────────────────────
# IEEE Xplore API key. arXiv needs no key. Check it with scripts/check_ieee.py.
IEEE_API_KEY=

# ── Pluto: finance ──────────────────────────────────────────────────────────
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html (macro data).
FRED_API_KEY=
# Zerodha Kite Connect (sync_broker). The access token EXPIRES DAILY, so set it
# for the session rather than saving it long-term. Never type either in chat.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ── Athena: OCR ─────────────────────────────────────────────────────────────
# Full path to the Tesseract binary if it is not on PATH (typical on Windows).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Logging ─────────────────────────────────────────────────────────────────
# Where rotating logs go (default: ./logs).
# HESTIA_LOG_DIR=logs
